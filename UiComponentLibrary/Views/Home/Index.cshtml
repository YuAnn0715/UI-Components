@model ComponentDemoViewModel
@{
    ViewData["Title"] = "元件展示";
}

<div class="row justify-content-center ui-showcase-page">
    <div class="col-12">
        <section class="ui-showcase-intro" aria-labelledby="showcase-title">
            <div>
                <p class="ui-showcase-eyebrow">Design workspace</p>
                <h1 id="showcase-title">元件展示</h1>
                <p>選擇元件、調整配色，直接取得可放入 Razor View 的 HTML。</p>
            </div>
            <div class="ui-showcase-intro-status"><i class="bi bi-palette2" aria-hidden="true"></i><span>即時配色預覽</span></div>
        </section>

        <div class="row g-4 align-items-start">
            <aside class="col-lg-3">
                <nav class="card shadow-sm ui-component-nav" data-ui-component-nav aria-label="元件導覽">
                    <div class="card-body p-3">
                        <div class="ui-nav-heading">表單元件</div>
                        <div class="nav nav-pills flex-column gap-1">
                            <button class="nav-link text-start" type="button" data-ui-show-guide>使用說明</button>
                            <button class="nav-link text-start active" type="button" data-ui-show-kind="text-input">Text Input</button>
                            <button class="nav-link text-start" type="button" data-ui-show-kind="textarea">Textarea</button>
                            <button class="nav-link text-start" type="button" data-ui-show-kind="select">Select</button>
                            <button class="nav-link text-start" type="button" data-ui-show-kind="tag-select">標籤式 Select</button>
                            <button class="nav-link text-start" type="button" data-ui-show-kind="checkbox">Checkbox</button>
                            <button class="nav-link text-start" type="button" data-ui-show-kind="radio">Radio</button>
                            <button class="nav-link text-start" type="button" data-ui-show-kind="button">Button</button>
                            <button class="nav-link text-start" type="button" data-ui-show-kind="file-upload">檔案上傳</button>
                            <button class="nav-link text-start" type="button" data-ui-show-kind="file-download">檔案下載</button>
                            <button class="nav-link text-start" type="button" data-ui-show-kind="data-table">Data Table</button>
                            <button class="nav-link text-start" type="button" data-ui-show-kind="date-picker">日期選擇器</button>
                            <button class="nav-link text-start" type="button" data-ui-show-kind="date-time-picker">日期＋時間</button>
                            <button class="nav-link text-start" type="button" data-ui-show-kind="time-picker">時間選擇器</button>
                            <button class="nav-link text-start" type="button" data-ui-show-kind="date-range-picker">日期區間</button>
                        </div>
                    </div>
                </nav>
            </aside>

            <div class="col-lg-9">
                <section class="card shadow-sm mb-4" data-ui-general-guide hidden>
                    <div class="card-body p-4">
                        <h2 class="h3">使用說明</h2>
                        <p class="text-secondary">目前展示站預覽使用 RCL 的 Razor Tag Helper；這個下載靜態元件包的流程只產生原生 HTML／JavaScript，獨立使用不需要 NuGet、Razor Tag Helper 或 Vue。展示站不載入 Vue runtime，也不示範 Vue adapter。</p>
                        <h3 class="h5 mt-4">1. 複製靜態檔案</h3>
                        <p><a class="btn btn-primary" href="/downloads/UiComponentLibrary-static.zip" download>下載靜態元件包</a></p>
                        <p>解壓縮後將兩個檔案放入新專案的 <code>wwwroot/lib/ui-components/</code>。</p>
                        <h3 class="h5 mt-4">2. 在 Layout 引用</h3>
                        <p>在 <code>Views/Shared/_Layout.cshtml</code> 加入：</p>
                        <pre class="ui-doc-code"><code>&lt;head&gt;
  &lt;link rel="stylesheet" href="~/lib/ui-components/ui-components.css" /&gt;
&lt;/head&gt;

&lt;script src="~/lib/ui-components/ui-components.js" defer&gt;&lt;/script&gt;</code></pre>
                        <h3 class="h5 mt-4">3. 複製元件 HTML</h3>
                        <p>在左側選擇元件與配色，從「可複製的 HTML 程式碼」複製到 Razor View。設定值使用原生 HTML 屬性，例如 <code>name</code>、<code>value</code>、<code>accept</code> 與 <code>option</code>。</p>
                        <h3 class="h5 mt-4">4. 取得表單資料</h3>
                        <pre class="ui-doc-code"><code>// Razor Page / Controller
var country = Request.Form["country"];
var skills = Request.Form["skills"];
var attachment = Request.Form.Files.GetFile("attachment");</code></pre>
                    </div>
                </section>

                <section class="card shadow-sm mb-4 ui-theme-editor" data-ui-theme-editor aria-labelledby="theme-editor-title">
                    <div class="card-body p-4">
                        <h2 class="h4" id="theme-editor-title">元件配色編輯器</h2>
                        <p class="text-secondary">選擇目前元件的其中一個預覽、調整開放顏色，然後複製可直接貼到 Razor View 的 HTML 程式碼。</p>
                        <div class="row mb-3 ui-color-controls">
                            <div class="col-md-4" data-ui-color-row><label class="form-label">邊框</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-border-color" data-ui-default="#ced4da" /></div>
                            <div class="col-md-4" data-ui-color-row><label class="form-label">焦點</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-focus-color" data-ui-default="#86b7fe" /></div>
                            <div class="col-md-4" data-ui-color-row><label class="form-label">文字</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-text-color" data-ui-default="#212529" /></div>
                            <div class="col-md-4" data-ui-color-row><label class="form-label">背景</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-background-color" data-ui-default="#ffffff" /></div>
                            <div class="col-md-6" data-ui-color-row><label class="form-label">按鈕背景</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-button-background" data-ui-default="#0d6efd" /></div>
                            <div class="col-md-6" data-ui-color-row><label class="form-label">按鈕文字</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-button-text" data-ui-default="#ffffff" /></div>
                            <div class="col-md-6" data-ui-color-row><label class="form-label">按鈕外框</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-button-border" data-ui-default="#0d6efd" /></div>
                            <div class="col-md-6" data-ui-color-row><label class="form-label">確認按鈕</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-confirm-color" data-ui-default="#4f46e5" /></div>
                            <div class="col-md-6" data-ui-color-row><label class="form-label">取消按鈕</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-cancel-color" data-ui-default="#64748b" /></div>
                            <div class="col-md-6" data-ui-color-row><label class="form-label">選取日期／起日／迄日</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-range-endpoint-color" data-ui-default="#4f46e5" /></div>
                            <div class="col-md-6" data-ui-color-row><label class="form-label">選取區間</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-range-fill-color" data-ui-default="#ddd6fe" /></div>
                            <div class="col-md-4" data-ui-color-row><label class="form-label">時鐘翻頁按鈕</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-time-control-color" data-ui-default="#475569" /></div>
                            <div class="col-md-4" data-ui-color-row><label class="form-label">翻頁時鐘數字</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-flip-number-color" data-ui-default="#ffffff" /></div>
                            <div class="col-md-4" data-ui-color-row><label class="form-label">翻頁時鐘底色</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-flip-number-background" data-ui-default="#1e293b" /></div>
                        </div>
                        <div class="row mb-3 ui-color-controls">
                            <div class="col-md-4" data-ui-color-row><label class="form-label">上傳外框</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-upload-border-color" data-ui-default="#8b5cf6" /></div>
                            <div class="col-md-4" data-ui-color-row><label class="form-label">上傳進度條</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-upload-progress-color" data-ui-default="#4f46e5" /></div>
                            <div class="col-md-4" data-ui-color-row><label class="form-label">瀏覽按鈕</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-upload-button-color" data-ui-default="#4f46e5" /></div>
                        </div>
                        <div class="row mb-3 ui-color-controls ui-tag-color-controls">
                            <div class="col-md-4" data-ui-color-row><label class="form-label">標籤顏色</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-tag-color" data-ui-default="#4f46e5" /></div>
                            <div class="col-md-4" data-ui-color-row><label class="form-label">標籤內文字顏色</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-tag-text-color" data-ui-default="#ffffff" /></div>
                        </div>
                        <div class="row mb-3 ui-color-controls ui-data-table-color-controls">
                            <div class="col-md-4" data-ui-color-row><label class="form-label">表頭背景</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-table-header-background" data-ui-default="#f7e9ea" /></div>
                            <div class="col-md-4" data-ui-color-row><label class="form-label">表頭文字</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-table-header-text" data-ui-default="#111827" /></div>
                            <div class="col-md-4" data-ui-color-row><label class="form-label">表格邊框</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-table-border" data-ui-default="#d8dee8" /></div>
                            <div class="col-md-4" data-ui-color-row><label class="form-label">斑馬紋</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-table-stripe" data-ui-default="#f3f4f6" /></div>
                            <div class="col-md-4" data-ui-color-row><label class="form-label">分頁強調</label><input class="form-control form-control-color" type="color" data-ui-color="--ui-table-accent" data-ui-default="#a78bb0" /></div>
                        </div>
                        <div class="ui-upload-settings mt-3" data-ui-upload-settings hidden>
                            <div>
                                <label class="form-label" for="ui-upload-accept">允許檔案類型</label>
                                <input class="form-control" id="ui-upload-accept" type="text" value=".pdf,.doc,.docx" data-ui-upload-accept />
                                <div class="form-text">以逗號分隔，例如：.pdf,.docx 或 image/png,image/jpeg</div>
                            </div>
                            <div>
                                <label class="form-label" for="ui-upload-max-size">單一檔案上限（MB）</label>
                                <input class="form-control" id="ui-upload-max-size" type="number" min="1" max="2048" value="10" data-ui-upload-max-size />
                            </div>
                        </div>
                        <details class="ui-code-details">
                            <summary>顯示可複製的 HTML 程式碼</summary>
                            <div class="ui-showcase-code-panel mt-3">
                                <div class="ui-showcase-code-panel-header"><span>HTML</span><span>可直接貼入 Razor View</span></div>
                                <pre class="ui-code-output mb-0" id="ui-code"><code data-ui-generated-code></code></pre>
                            </div>
                            <button class="btn btn-outline-primary" type="button" data-ui-copy>複製程式碼</button>
                        </details>
                    </div>
                </section>

                <section aria-labelledby="component-preview-title" data-ui-preview-section>
                    <div class="mb-3">
                        <h2 class="h3 mb-1" id="component-preview-title">Text Input 預覽</h2>
                    </div>
                    <form method="post" enctype="multipart/form-data" class="card shadow-sm ui-preview-card">
                        <div class="card-body p-4">
                            <div class="row g-2 g-lg-4">
                                <div class="col-12" data-ui-preview-item data-ui-preview-kind="text-input">
                                    <div class="row g-2 g-lg-4">
                                        <div class="col-md-6"><ui-text-input asp-for="Name" placeholder="請輸入姓名" border-color="#8b5cf6" focus-color="#7c3aed" /></div>
                                    </div>
                                </div>
                                <div class="col-12" data-ui-preview-item data-ui-preview-kind="textarea" hidden><ui-textarea asp-for="Notes" placeholder="可選填" rows="3" background-color="#f8fafc" /></div>
                                <div class="col-md-6" data-ui-preview-item data-ui-preview-kind="select" hidden><ui-select asp-for="Country" items="Model.Countries" items-expression="Model.Countries" focus-color="#16a34a" /></div>
                                <div class="col-md-8" data-ui-preview-item data-ui-preview-kind="tag-select" hidden><ui-tag-select asp-for="Skills" items="Model.SkillOptions" items-expression="Model.SkillOptions" border-color="#cbd5e1" focus-color="#4f46e5" text-color="#0f172a" background-color="#ffffff" tag-color="#4f46e5" tag-text-color="#ffffff" /></div>
                                <div class="col-md-6 pt-md-4" data-ui-preview-item data-ui-preview-kind="checkbox" hidden><ui-checkbox asp-for="EmailUpdates" label="我想收到產品更新" focus-color="#ea580c" /></div>
                                <div class="col-md-6" data-ui-preview-item data-ui-preview-kind="radio" hidden>
                                    <fieldset class="mb-3">
                                        <legend class="fs-6">偏好的聯絡方式</legend>
                                        <ui-radio asp-for="PreferredContact" value="Email" label="電子郵件" focus-color="#2563eb" />
                                        <ui-radio asp-for="PreferredContact" value="Phone" label="電話" focus-color="#2563eb" />
                                    </fieldset>
                                </div>
                                <div class="col-12" data-ui-preview-item data-ui-preview-kind="button" hidden><ui-button background-color="#4f46e5">送出表單</ui-button></div>
                                <div class="col-md-8" data-ui-preview-item data-ui-preview-kind="file-upload" hidden><ui-file-upload asp-for="UploadFile" label="附件" accept=".pdf,.doc,.docx" max-size-mb="10" border-color="#8b5cf6" progress-color="#4f46e5" button-color="#4f46e5" /></div>
                                <div class="col-12" data-ui-preview-item data-ui-preview-kind="file-download" hidden><ui-file-download label="年度報告" file-name="年度報告.txt" file-url="/downloads/download-demo.txt" /></div>
                                <div class="col-12" data-ui-preview-item data-ui-preview-kind="data-table" hidden>
                                    <ui-data-table page-size="10" page-size-options="10,25,50" header-background-color="#f7e9ea" accent-color="#a78bb0" table-border-color="#d8dee8" stripe-background-color="#f3f4f6">
                                        <table>
                                            <thead>
                                                <tr>
                                                    <th data-ui-sort-type="number">單位代號</th>
                                                    <th>單位</th>
                                                    <th data-ui-sort-type="number">員編</th>
                                                    <th>姓名</th>
                                                    <th>職稱</th>
                                                    <th data-ui-sortable="false">講師身份</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            @foreach (var row in Model.DataTableRows)
                                            {
                                                <tr>
                                                    <td data-ui-sort-value="@row.UnitCode">@row.UnitCode</td>
                                                    <td>@row.UnitName</td>
                                                    <td data-ui-sort-value="@row.EmployeeCode">@row.EmployeeCode</td>
                                                    <td>@row.Name</td>
                                                    <td>@row.Title</td>
                                                    <td>@row.Instructor</td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    </ui-data-table>
                                </div>
                                <div class="col-md-6" data-ui-preview-item data-ui-preview-kind="date-picker" hidden><ui-date-picker asp-for="SelectedDate" confirm-color="#4f46e5" cancel-color="#64748b" endpoint-color="#4f46e5" /></div>
                                <div class="col-md-6" data-ui-preview-item data-ui-preview-kind="date-time-picker" hidden><ui-date-time-picker asp-for="SelectedDateTime" confirm-color="#4f46e5" cancel-color="#64748b" endpoint-color="#4f46e5" /></div>
                                <div class="col-md-6" data-ui-preview-item data-ui-preview-kind="time-picker" hidden><ui-time-picker asp-for="SelectedTime" confirm-color="#4f46e5" cancel-color="#64748b" control-color="#475569" flip-number-color="#ffffff" flip-number-background-color="#1e293b" /></div>
                                <div class="col-md-8" data-ui-preview-item data-ui-preview-kind="date-range-picker" hidden><ui-date-range-picker asp-for-start="StartDate" asp-for-end="EndDate" label="住宿日期" confirm-color="#4f46e5" cancel-color="#64748b" endpoint-color="#4f46e5" range-color="#ddd6fe" /></div>
                            </div>
                        </div>
                    </form>
                </section>

                <section class="card shadow-sm mt-4" data-ui-component-doc aria-labelledby="component-doc-title">
                    <div class="card-body p-4">
                        <h2 class="h4" id="component-doc-title">Text Input 設定</h2>
                        <p class="text-secondary" data-ui-doc-summary></p>
                        <div class="row g-4">
                            <div class="col-lg-7">
                                <h3 class="h6">HTML 用法</h3>
                                <div class="ui-showcase-code-panel">
                                    <div class="ui-showcase-code-panel-header"><span>HTML</span><span>與上方配色同步</span></div>
                                    <pre class="ui-doc-code mb-0"><code data-ui-doc-razor></code></pre>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <h3 class="h6">資料與設定</h3>
                                <div data-ui-doc-data></div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>
