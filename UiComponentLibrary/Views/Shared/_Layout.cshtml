<!doctype html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - UiComponentLibrary</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/ui-components/ui-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/showcase.css" asp-append-version="true" />
</head>
<body class="ui-showcase-body">
    <header class="ui-showcase-header">
        <div class="container-fluid ui-showcase-header-inner">
            <a class="ui-showcase-brand" asp-controller="Home" asp-action="Index">
                <span class="ui-showcase-brand-mark" aria-hidden="true">
                    <i class="bi bi-grid-1x2-fill"></i>
                </span>
                <span>UI Component Library</span>
            </a>
            <div class="ui-showcase-header-actions">
                <a class="ui-header-action ui-header-action-primary"
                       href="~/downloads/UiComponentLibrary-static.zip"
                       download>
                    <i class="bi bi-download" aria-hidden="true"></i>
                    <span>下載元件包</span>
                </a>
                <a class="ui-header-action"
                       href="https://github.com/YuAnn0715/UI-Components"
                       target="_blank"
                       rel="noopener">
                    <i class="bi bi-github" aria-hidden="true"></i>
                    <span>GitHub</span>
                </a>
            </div>
        </div>
    </header>
    <main class="container-fluid ui-showcase-shell">@RenderBody()</main>
    <footer class="ui-showcase-footer" aria-label="版權聲明">
        <span>&copy; @DateTime.Now.Year Yu Ann Cai，版權所有</span>
    </footer>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/lib/ui-components/ui-components.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
